{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-devsecops-lab:scan-report:1.0",
  "title": "Local lab scan observations and execution",
  "type": "object",
  "required": ["schema_version", "run_id", "source_revision", "source_fingerprint", "tool_versions", "timestamp", "execution_status", "steps", "findings", "evidence_manifest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_versions": {"type": "object"},
    "timestamp": {"type": "string", "format": "date-time"},
    "execution_status": {"enum": ["COMPLETED", "FAILED", "PARTIAL", "NOT_EXECUTED", "INTERRUPTED"]},
    "steps": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["tool", "execution_status", "finding_count", "execution_mode", "exit_codes", "evidence"],
        "properties": {
          "tool": {"enum": ["semgrep", "codeql", "zap"]},
          "execution_status": {"enum": ["COMPLETED", "FAILED", "TIMED_OUT", "INTERRUPTED", "NOT_EXECUTED", "TARGET_UNREACHABLE"]},
          "execution_mode": {"enum": ["actual-execution", "historical-reuse", "not-executed"]},
          "finding_count": {"type": ["integer", "null"], "minimum": 0},
          "exit_codes": {"type": "array", "items": {"type": ["integer", "null"]}},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [{
          "if": {"properties": {"execution_status": {"const": "COMPLETED"}}},
          "then": {"properties": {"finding_count": {"type": "integer"}}},
          "else": {"properties": {"finding_count": {"type": "null"}}}
        }]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "run_id", "source_revision", "tool", "rule_id", "title", "severity", "confidence", "source_location", "target_url", "evidence_reference", "finding_status", "execution_status", "timestamp", "fingerprint", "null_reasons"],
        "properties": {
          "schema_version": {"const": "1.0"},
          "run_id": {"type": "string"}, "source_revision": {"type": "string"},
          "tool": {"enum": ["semgrep", "codeql", "zap"]},
          "rule_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low", "informational", null]},
          "confidence": {"enum": ["low", "medium", "high", "very-high", "confirmed", "false-positive", null]},
          "source_location": {
            "type": ["object", "null"], "required": ["path", "line"],
            "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}}
          },
          "target_url": {"type": ["string", "null"]},
          "evidence_reference": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "finding_status": {"const": "unreviewed"}, "execution_status": {"const": "COMPLETED"},
          "timestamp": {"type": "string", "format": "date-time"},
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "null_reasons": {"type": "object"}
        }
      }
    },
    "evidence_manifest": {
      "type": "array", "items": {"type": "object", "required": ["path", "sha256"],
        "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    },
    "independent_vulnerability_count": {"type": "null"}
  }
}
