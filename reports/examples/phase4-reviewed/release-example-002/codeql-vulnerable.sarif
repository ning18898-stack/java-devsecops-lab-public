          "ruleId": "java/lab-idor-update-owner",
          "ruleIndex": 1,
          "rule": {
            "id": "java/lab-idor-update-owner",
            "index": 1
          },
          "message": {
            "text": "Owner-only lab write policy requires a bound user_id predicate in the UPDATE WHERE clause."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main/java/com/example/devsecopslab/lab/vuln002/IdorMapper.java",
                  "uriBaseId": "%SRCROOT%",
                  "index": 4
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 5,
                  "endColumn": 140
                },
                "contextRegion": {
                  "startLine": 8,
                  "endLine": 12,
                  "snippet": {
                    "text": "    @Select(\"SELECT id,user_id AS userId,title,content,created_at AS createdAt,updated_at AS updatedAt,run_id AS runId FROM lab_articles WHERE id=#{id} AND run_id=#{runId}\")\r\n    IdorArticle find(@Param(\"id\") long id, @Param(\"runId\") String runId);\r\n    @Update(\"UPDATE lab_articles SET title=#{title},content=#{content},updated_at=CURRENT_TIMESTAMP(6) WHERE id=#{id} AND run_id=#{runId}\")\r\n    int update(@Param(\"id\") long id,@Param(\"runId\") String runId,\r\n            @Param(\"title\") String title,@Param(\"content\") String content);\r\n"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "e706aee116cd2b3b:1",
            "primaryLocationStartColumnFingerprint": "0"
          }
        },
        {
          "ruleId": "java/lab-idor-service-owner",
          "ruleIndex": 2,
          "rule": {
            "id": "java/lab-idor-service-owner",
            "index": 2
          },
          "message": {
            "text": "Lab write lacks the recognized controlling owner guard and principal identity argument; inspect authorization."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main/java/com/example/devsecopslab/lab/vuln002/IdorService.java",
                  "uriBaseId": "%SRCROOT%",
                  "index": 5
                },
                "region": {
                  "startLine": 15,
                  "startColumn": 25,
                  "endColumn": 97
                },
                "contextRegion": {
                  "startLine": 13,
                  "endLine": 17,
                  "snippet": {
                    "text": "            var original=require(mapper.find(id,principal.getRunId()));\r\n            // Intentional VULN-002: no object ownership check.\r\n            int changed=mapper.update(id,principal.getRunId(),request.title(),request.content());\r\n            if(changed==0) {\r\n                // Preserve correct idempotent PUT behavior with MySQL affected-row settings.\r\n"
                  }
                }
              }
            }
          ],
